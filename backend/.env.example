# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Sarvam AI (Speech-to-Text / Text-to-Speech) ---
SARVAM_API_KEY=

# --- Groq (transcript proofreading, translation, WhatsApp AI replies) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- MongoDB ---
MONGODB_URI=
MONGODB_DB=obd_suite

# --- Sarv Voice Broadcast (OBD calling) ---
SARV_USER_ID=
SARV_USER_TOKEN=
SARV_PLAN_ID=
SARV_PLAN_TYPE=C
SARV_INCLUDES_COUNTRY_CODE=N
# Any random secret string - locks down the /webhooks/sarv-status endpoint
# so only Sarv (who gets it appended as ?key=... on the callback URL) can
# write call statuses. Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SARV_WEBHOOK_SECRET=
# Leave blank on Render (auto-detected from RENDER_EXTERNAL_URL). Set this
# manually only for local/ngrok use, e.g. https://abcd-1234.ngrok-free.app
PUBLIC_BASE_URL=

# Comma-separated list of allowed frontend origins in production, e.g.
# https://obd-frontend-xxxx.onrender.com — leave unset locally (defaults to "*")
ALLOWED_ORIGINS=

# --- WhatsApp Cloud API (Meta for Developers) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Any random secret string - must match the "Verify token" you set in the
# Meta App Dashboard's WhatsApp webhook configuration.
WHATSAPP_VERIFY_TOKEN=

# --- Firebase Admin SDK (login / User Management / RBAC) ---
# Download from Firebase Console -> Project Settings -> Service Accounts ->
# "Generate new private key", save as backend/firebase-service-account.json
# (default path below already points there - only set this if you keep it
# somewhere else, e.g. a Render Secret File mounted at /etc/secrets/...).
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
