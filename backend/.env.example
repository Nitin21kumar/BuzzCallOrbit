# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it's already in .gitignore.

# Sarvam AI - used for Text-to-Speech and Speech-to-Text (audio generation)
# Get your key from https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Groq - used for gender-aware translation (before TTS) and for proofreading
# raw STT transcripts. Get your key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# MongoDB connection
# Local Mongo:   mongodb://localhost:27017
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=obd_suite

# Sarv credentials (Sarv Console se milenge: https://console.sarv.com)
# vb-api v2 /broadcasting endpoint use hota hai
SARV_USER_ID=
SARV_USER_TOKEN=
SARV_PLAN_ID=
SARV_PLAN_TYPE=C
# Y agar aapke Excel/DB me numbers already country code ke saath hain (91XXXXXXXXXX),
# N agar sirf 10-digit mobile hai
SARV_INCLUDES_COUNTRY_CODE=N

# Public URL this backend is reachable at.
# Local + ngrok:  https://abcd-1234.ngrok-free.app
# Render:         https://<your-backend-service>.onrender.com  (no trailing slash)
PUBLIC_BASE_URL=

# Shared secret appended as ?key=... to the callback_url given to Sarv, so
# only Sarv's real requests (the ones carrying this key) can update call
# statuses through the webhook. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SARV_WEBHOOK_SECRET=

# Comma-separated list of frontend origin(s) allowed to call this API
# (CORS). Leave empty for local dev (defaults to allow-all).
# Example: https://obd-frontend-xhzq.onrender.com,http://localhost:5173
ALLOWED_ORIGINS=
